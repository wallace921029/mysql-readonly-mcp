# Copy to .env.secrets and fill in real values. Never commit.
# Variable names here must match the password_env / token_env entries
# referenced in config.yaml.

# DB passwords
MYSQL1_PASSWORD=replace-me
MYSQL2_PASSWORD=replace-me

# Per-user bearer tokens (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
TOKEN_ALICE=replace-me
TOKEN_BOB=replace-me
TOKEN_ADMIN=replace-me
